{
  "name": "GZLCore",
  "version": "1.0.0",
  "summary": "GZLCore cross-platform mini-app core library",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://images.tuyacn.com/smart/app/package/pods/ios/GZLCore-1.0.0-21d081.zip",
    "type": "zip",
    "sha1": "0abd49fd72974dd7a7cfa4ec869210026bd3ddbf"
  },
  "platforms": {
    "ios": "12.0"
  },
  "static_framework": true,
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/src/include $(PODS_TARGET_SRCROOT)/src/base/include $(PODS_TARGET_SRCROOT)/src/base/fml/include $(PODS_TARGET_SRCROOT)/src/common/include $(PODS_TARGET_SRCROOT)/src/core/include $(PODS_TARGET_SRCROOT)/src/core/page/include $(PODS_TARGET_SRCROOT)/src/runtime/include $(PODS_TARGET_SRCROOT)/src/runtime/jsi/include $(PODS_TARGET_SRCROOT)/src/runtime/jsi/common/include $(PODS_TARGET_SRCROOT)/src/runtime/jsi/jsc/include $(PODS_TARGET_SRCROOT)/third_party/modp_b64 $(PODS_TARGET_SRCROOT)/src/core/message/include $(PODS_TARGET_SRCROOT)/platform/ios/include",
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) GZLCORE_VERSION_MAJOR=1 GZLCORE_VERSION_MINOR=0 GZLCORE_VERSION_PATCH=0 OS_IOS=1 OS_POSIX=1",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
    "GCC_ENABLE_CPP_EXCEPTIONS": "NO",
    "GCC_ENABLE_CPP_RTTI": "NO",
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "frameworks": [
    "Foundation",
    "JavaScriptCore"
  ],
  "libraries": "stdc++",
  "compiler_flags": "-fobjc-arc",
  "vendored_frameworks": [
    "Build/GZLCore.xcframework"
  ],
  "source_files": [
    "Build/GZLCore.xcframework/ios-arm64/GZLCore.framework/Headers/*"
  ]
}
