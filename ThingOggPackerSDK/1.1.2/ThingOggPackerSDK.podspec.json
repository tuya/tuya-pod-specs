{
  "name": "ThingOggPackerSDK",
  "version": "1.1.2",
  "summary": "open SDK code for tuya video codec.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://images.tuyacn.com/smart/app/package/pods/ios/ThingOggPackerSDK-1.1.2-0d0d2c.zip",
    "type": "zip",
    "sha1": "118a5de2c594e51359514d077d5f83ef97716b5b"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": "ThingOggPackerSDK/**/Android/*.*",
  "ios": {
    "vendored_libraries": [
      "ThingOggPackerSDK/libs/iOS/*.a"
    ]
  },
  "dependencies": {
    "ThingAvLoggerSDK": [

    ]
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "OTHER_LDFLAGS": "-read_only_relocs suppress",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Source $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Source/ogg/include $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Include $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Include/avlog $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Source/ogg/src",
    "ENABLE_BITCODE": "NO"
  },
  "vendored_frameworks": [
    "Build/ThingOggPackerSDK.xcframework"
  ],
  "source_files": [
    "Build/ThingOggPackerSDK.xcframework/ios-arm64/ThingOggPackerSDK.framework/Headers/*.{h,hh,hpp,ipp,tpp,hxx,def,inl,inc}"
  ]
}
