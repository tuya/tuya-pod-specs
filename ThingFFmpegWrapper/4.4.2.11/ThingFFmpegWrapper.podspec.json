{
  "name": "ThingFFmpegWrapper",
  "version": "4.4.2.11",
  "summary": "tuya ffmpeg wrapper .",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://images.tuyacn.com/smart/app/package/pods/ios/ThingFFmpegWrapper-4.4.2.11-2d6049.zip",
    "type": "zip",
    "sha1": "d0689000d62f85f6b69aef619fb02d5ed181424f"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": [
    "ThingFFmpegWrapper/libs/Android/*",
    "ThingFFmpegWrapper/Platforms/Android/*"
  ],
  "ios": {
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "OTHER_LDFLAGS": "-read_only_relocs suppress",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingFFmpegWrapper $(PODS_TARGET_SRCROOT)/ThingFFmpegWrapper/Platforms/iOS  $(PODS_TARGET_SRCROOT)/ThingFFmpegWrapper/include/ffmpeg ",
    "ENABLE_BITCODE": "NO"
  },
  "vendored_frameworks": [
    "Build/ThingFFmpegWrapper.xcframework"
  ],
  "source_files": [
    "Build/ThingFFmpegWrapper.xcframework/ios-arm64/ThingFFmpegWrapper.framework/Headers/*.{h,hh,hpp,ipp,tpp,hxx,def,inl,inc}"
  ]
}
