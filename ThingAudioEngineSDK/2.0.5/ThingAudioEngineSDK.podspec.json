{
  "name": "ThingAudioEngineSDK",
  "version": "2.0.5",
  "summary": "ThingAudioEngineSDK framework.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://images.tuyacn.com/smart/app/package/pods/ios/ThingAudioEngineSDK-2.0.5-8cdf60.zip",
    "type": "zip",
    "sha1": "9ed8ed2cf9bcb057247337a22ecb219094ca0029"
  },
  "platforms": {
    "ios": "12.0"
  },
  "exclude_files": [
    "ThingAudioEngineSDK/**/Android/**/*.*",
    "ThingAudioEngineSDK/include/tensorflow/**/*.*",
    "ThingAudioEngineSDK/include/tyap/*.*",
    "ThingAudioEngineSDK/Utils/rapidjson/msinttypes/*.*"
  ],
  "dependencies": {
    "ThingAvLoggerSDK": [

    ],
    "ThingInferenceSDK": [

    ],
    "ThingAudioProcessSDK": [

    ]
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/include $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/codec $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/include/audio-process $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-engine $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-logger $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-player $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-processer $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-recorder $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/include/tyap $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/vad $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/utils $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/interface $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-inference $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/quality-detector $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/quality-detector/pesq $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/rnnoise",
    "ENABLE_BITCODE": "NO"
  },
  "vendored_frameworks": [
    "Build/ThingAudioEngineSDK.xcframework"
  ],
  "source_files": [
    "Build/ThingAudioEngineSDK.xcframework/ios-arm64/ThingAudioEngineSDK.framework/Headers/*.{h,hh,hpp,ipp,tpp,hxx,def,inl,inc}"
  ]
}
