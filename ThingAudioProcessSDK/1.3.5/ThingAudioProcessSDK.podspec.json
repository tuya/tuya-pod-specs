  },
  "vendored_frameworks": [
    "Build/ThingAudioProcessSDK.xcframework"
  ],
  "source_files": [
    "Build/ThingAudioProcessSDK.xcframework/ios-arm64/ThingAudioProcessSDK.framework/Headers/*.{h,hh,hpp,ipp,tpp,hxx,def,inl,inc}"
