    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include/webrtc $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include/webrtc/third_party/abseil-cpp $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/avlogger $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/thing_inference $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/effect $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/effect/tuning $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/effect/fft $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/effect/mem $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/effect/include $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/vad $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/apm $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/rnnoise $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/resample",
